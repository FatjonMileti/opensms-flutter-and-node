# ---------------------------------------------------------------------------
# OpenSMS relay server configuration. Copy to .env and edit.
# ---------------------------------------------------------------------------

# HTTP / WebSocket listener
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Public WebSocket path used by the Flutter gateway
WS_PATH=/ws

# --- Credentials -----------------------------------------------------------
# Comma separated. If left empty the server generates one at boot and prints
# it to the console. Never ship a real key in source control.
API_KEYS=
# Tokens the Android gateway may authenticate with (comma separated).
DEVICE_TOKENS=
# Required for /api/v1/admin/*. If empty, all admin routes return 503.
ADMIN_TOKEN=change-me-admin-token

# --- CORS ------------------------------------------------------------------
# Comma separated origins, or * for any (development only).
CORS_ORIGINS=*

# --- Queue behaviour -------------------------------------------------------
# Drop pending messages older than this (ms) -> Failed / expired.
MESSAGE_TTL_MS=86400000
# A message stuck in "Sending" for longer than this is requeued (ms).
STUCK_TIMEOUT_MS=120000
# After this many delivery attempts a message is marked Failed.
MAX_ATTEMPTS=3

# --- Limits ----------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
BODY_LIMIT=64kb
# Server-side WebSocket ping interval (ms) used to reap dead sockets.
WS_HEARTBEAT_MS=30000
# How long a new socket may stay unauthenticated before it is closed (ms).
WS_AUTH_GRACE_MS=10000
